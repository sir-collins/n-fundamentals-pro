@baseUrl = http://localhost:3000

### Get all songs (paginated — defaults to page 1, limit 10)
# Response shape: { "data": Song[], "total": number }
GET {{baseUrl}}/songs

### Get songs, page 2 with 5 per page
GET {{baseUrl}}/songs?page=2&limit=5

### Create new song
POST {{baseUrl}}/songs
Content-Type: application/json

{
  "title": "Blinding Lights",
  "artists": ["The Weeknd"],
  "releaseDate": "2019-11-29",
  "duration": "00:03"
}

### Get a single song
# artists comes back as [{ id, name }, ...] — real Artist rows, not strings.
# Reusing "The Weeknd" across songs resolves to the same Artist id.
GET {{baseUrl}}/songs/1

### Update a song
# artists here is still names in, same as create — replaces this song's
# artists entirely (not additive). A name already used elsewhere is reused,
# not duplicated; a name dropped from every song stays as an orphaned
# Artist row (nothing prunes those yet).
PUT {{baseUrl}}/songs/1
Content-Type: application/json

{
  "title": "Blinding Lights (Remix)",
  "artists": ["The Weeknd", "Rosalía"],
  "releaseDate": "2020-08-05",
  "duration": "00:03"
}

### Delete a song
DELETE {{baseUrl}}/songs/1

### Sign up
# Response is { id, email } only — the password hash never comes back.
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### Sign up again with the same email (should 409)
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### Log in
# Response is { access_token }. AuthGuard('local') checks email/password
# against the stored bcrypt hash before this ever reaches the handler.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### Log in with the wrong password (should 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "wrongpassword"
}

### Log in with an email that was never signed up (should 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "correcthorsebattery"
}

### Get my profile (paste in a fresh access_token from "Log in" above)
# First protected route — AuthGuard('jwt') checks the token before this
# ever runs. Response is { id, email }.
@token = PASTE_ACCESS_TOKEN_HERE
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{token}}

### Get my profile with no token (should 401)
GET {{baseUrl}}/auth/profile

### Sign up a second user, to promote to admin below
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "admin-candidate@example.com",
  "password": "correcthorsebattery"
}

### Promote that user to admin — there's no API for this on purpose
# (signup can never hand out a role). Run directly against Postgres:
#   docker exec n-fundamentals-postgres psql -U nestjs -d n_fundamentals \
#     -c "UPDATE \"user\" SET role = 'admin' WHERE email = 'admin-candidate@example.com';"

### Log in as the (now-promoted) admin
# access_token's payload includes role: "admin" — paste it below as @adminToken.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin-candidate@example.com",
  "password": "correcthorsebattery"
}

### Create a song as admin (should succeed)
@adminToken = PASTE_ADMIN_ACCESS_TOKEN_HERE
POST {{baseUrl}}/songs
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "RBAC Test Song",
  "artists": ["Test Artist"],
  "releaseDate": "2024-01-01",
  "duration": "00:03"
}

### Create a song as a regular (non-admin) user (should 403)
# Reuse @token from the "Log in" block above (learner@example.com, role "user").
POST {{baseUrl}}/songs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "RBAC Test Song",
  "artists": ["Test Artist"],
  "releaseDate": "2024-01-01",
  "duration": "00:03"
}

### Get all songs — still needs no token at all; reads stay public
GET {{baseUrl}}/songs

### Generate a 2FA secret (paste in a fresh @token from "Log in" above)
# Response is { qrCodeDataUrl }, a data:image/png;base64,... string — paste
# it into a browser address bar to see the QR code, or scan it with a real
# authenticator app (Google Authenticator, Authy, ...). Calling this again
# overwrites the previous secret, so re-scan if you do.
POST {{baseUrl}}/auth/2fa/generate
Authorization: Bearer {{token}}

### Confirm 2FA setup with the code your authenticator app shows
# Since the secret is stored in plain text (a known, deliberate gap — see
# the journal), you can also compute a code without a real app:
#   docker exec n-fundamentals-postgres psql -U nestjs -d n_fundamentals \
#     -t -A -c "SELECT \"twoFactorSecret\" FROM \"user\" WHERE email = 'learner@example.com';"
#   node -e "console.log(require('otplib').authenticator.generate('PASTE_SECRET_HERE'))"
POST {{baseUrl}}/auth/2fa/turn-on
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "PASTE_TOTP_CODE_HERE"
}

### Confirm 2FA setup with an obviously wrong code (should 400)
POST {{baseUrl}}/auth/2fa/turn-on
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "000000"
}
