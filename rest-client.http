@baseUrl = http://localhost:3000

### Get all songs (paginated — defaults to page 1, limit 10)
# Response shape: { "data": Song[], "total": number }
GET {{baseUrl}}/songs

### Get songs, page 2 with 5 per page
GET {{baseUrl}}/songs?page=2&limit=5

### Create new song
POST {{baseUrl}}/songs
Content-Type: application/json

{
  "title": "Blinding Lights",
  "artists": ["The Weeknd"],
  "releaseDate": "2019-11-29",
  "duration": "00:03"
}

### Get a single song
# artists comes back as [{ id, name }, ...] — real Artist rows, not strings.
# Reusing "The Weeknd" across songs resolves to the same Artist id.
GET {{baseUrl}}/songs/1

### Update a song
# artists here is still names in, same as create — replaces this song's
# artists entirely (not additive). A name already used elsewhere is reused,
# not duplicated; a name dropped from every song stays as an orphaned
# Artist row (nothing prunes those yet).
PUT {{baseUrl}}/songs/1
Content-Type: application/json

{
  "title": "Blinding Lights (Remix)",
  "artists": ["The Weeknd", "Rosalía"],
  "releaseDate": "2020-08-05",
  "duration": "00:03"
}

### Delete a song
DELETE {{baseUrl}}/songs/1
