@baseUrl = http://localhost:3000

### Get all songs (paginated — defaults to page 1, limit 10)
# Response shape: { "data": Song[], "total": number }
GET {{baseUrl}}/songs

### Get songs, page 2 with 5 per page
GET {{baseUrl}}/songs?page=2&limit=5

### Create new song
POST {{baseUrl}}/songs
Content-Type: application/json

{
  "title": "Blinding Lights",
  "artists": ["The Weeknd"],
  "releaseDate": "2019-11-29",
  "duration": "00:03"
}

### Get a single song
# artists comes back as [{ id, name }, ...] — real Artist rows, not strings.
# Reusing "The Weeknd" across songs resolves to the same Artist id.
GET {{baseUrl}}/songs/1

### Update a song
# artists here is still names in, same as create — replaces this song's
# artists entirely (not additive). A name already used elsewhere is reused,
# not duplicated; a name dropped from every song stays as an orphaned
# Artist row (nothing prunes those yet).
PUT {{baseUrl}}/songs/1
Content-Type: application/json

{
  "title": "Blinding Lights (Remix)",
  "artists": ["The Weeknd", "Rosalía"],
  "releaseDate": "2020-08-05",
  "duration": "00:03"
}

### Delete a song
DELETE {{baseUrl}}/songs/1

### Sign up
# Response is { id, email } only — the password hash never comes back.
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### Sign up again with the same email (should 409)
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### Log in
# AuthGuard('local') checks email/password against the stored bcrypt hash
# before this ever reaches the handler. Response is { access_token } for
# an account with 2FA off — but learner@example.com has 2FA ON as of the
# "Confirm 2FA setup" block further down, so this now returns
# { twoFactorRequired: true, tempToken } instead; see the "2FA login"
# section at the bottom of this file to complete that flow.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### Log in with the wrong password (should 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "wrongpassword"
}

### Log in with an email that was never signed up (should 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "correcthorsebattery"
}

### Get my profile (paste in a fresh access_token from "Log in" above)
# First protected route — AuthGuard('jwt') checks the token before this
# ever runs. Response is { id, email }.
@token = PASTE_ACCESS_TOKEN_HERE
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{token}}

### Get my profile with no token (should 401)
GET {{baseUrl}}/auth/profile

### Sign up a second user, to promote to admin below
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "admin-candidate@example.com",
  "password": "correcthorsebattery"
}

### Promote that user to admin — there's no API for this on purpose
# (signup can never hand out a role). Run directly against Postgres:
#   docker exec n-fundamentals-postgres psql -U nestjs -d n_fundamentals \
#     -c "UPDATE \"user\" SET role = 'admin' WHERE email = 'admin-candidate@example.com';"

### Log in as the (now-promoted) admin
# access_token's payload includes role: "admin" — paste it below as @adminToken.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin-candidate@example.com",
  "password": "correcthorsebattery"
}

### Create a song as admin (should succeed)
@adminToken = PASTE_ADMIN_ACCESS_TOKEN_HERE
POST {{baseUrl}}/songs
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "RBAC Test Song",
  "artists": ["Test Artist"],
  "releaseDate": "2024-01-01",
  "duration": "00:03"
}

### Create a song as a regular (non-admin) user (should 403)
# Reuse @token from the "Log in" block above (learner@example.com, role "user").
POST {{baseUrl}}/songs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "RBAC Test Song",
  "artists": ["Test Artist"],
  "releaseDate": "2024-01-01",
  "duration": "00:03"
}

### Get all songs — still needs no token at all; reads stay public
GET {{baseUrl}}/songs

### Generate a 2FA secret (paste in a fresh @token from "Log in" above)
# Response is { qrCodeDataUrl }, a data:image/png;base64,... string — paste
# it into a browser address bar to see the QR code, or scan it with a real
# authenticator app (Google Authenticator, Authy, ...). Calling this again
# overwrites the previous secret, so re-scan if you do.
POST {{baseUrl}}/auth/2fa/generate
Authorization: Bearer {{token}}

### Confirm 2FA setup with the code your authenticator app shows
#
# RECOVERING A CODE WITHOUT THE AUTHENTICATOR APP
# Since the secret is stored in plain text (a known, deliberate gap — see
# the journal), you're never actually locked out even if the app entry
# gets deleted/lost — pull the secret straight from Postgres and compute
# the current code yourself:
#   1) docker exec n-fundamentals-postgres psql -U nestjs -d n_fundamentals \
#        -t -A -c "SELECT \"twoFactorSecret\" FROM \"user\" WHERE email = 'YOUR_EMAIL_HERE';"
#   2) node -e "console.log(require('otplib').authenticator.generate('PASTE_SECRET_HERE'))"
# This exact two-step recipe works anywhere a 6-digit code is asked for
# below (turn-on, and the 2FA login steps further down) — swap the email
# and re-run whenever you need a fresh code.
POST {{baseUrl}}/auth/2fa/turn-on
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "PASTE_TOTP_CODE_HERE"
}

### Confirm 2FA setup with an obviously wrong code (should 400)
POST {{baseUrl}}/auth/2fa/turn-on
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "000000"
}

### 2FA login, step 1: log in as a 2FA-enabled user
# learner@example.com has 2FA on (see above) — response is
# { twoFactorRequired: true, tempToken }, not an access_token.
@tempToken = PASTE_TEMP_TOKEN_HERE
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### 2FA login, step 2: exchange the tempToken + a real code for a real token
# Need a code and don't have the authenticator app handy (lost/uninstalled
# it, etc.)? See "RECOVERING A CODE WITHOUT THE AUTHENTICATOR APP" above
# ("Confirm 2FA setup" block) — same two-step psql + otplib recipe works
# here too. Response is a normal { access_token } — usable anywhere a
# regular login's token is, including GET /auth/profile.
POST {{baseUrl}}/auth/2fa/authenticate
Content-Type: application/json

{
  "tempToken": "{{tempToken}}",
  "code": "PASTE_TOTP_CODE_HERE"
}

### 2FA login: wrong code (should 400)
POST {{baseUrl}}/auth/2fa/authenticate
Content-Type: application/json

{
  "tempToken": "{{tempToken}}",
  "code": "000000"
}

### 2FA login: garbage tempToken (should 401)
POST {{baseUrl}}/auth/2fa/authenticate
Content-Type: application/json

{
  "tempToken": "not.a.realtoken",
  "code": "123456"
}

### 2FA login: a tempToken must NOT work as a real access token (should 401)
# Proves the tempToken can't be used to bypass 2FA on a guarded route.
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{tempToken}}

### API keys, step 1: sign up + log in a plain (non-2FA) user to mint a key with
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "apikey-user@example.com",
  "password": "correcthorsebattery"
}

###
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "apikey-user@example.com",
  "password": "correcthorsebattery"
}

### API keys, step 2: mint a key (needs a real JWT, not an API key —
# minting requires AuthGuard('jwt') on purpose, so a leaked key can't be
# used to mint its own unlimited replacements).
# Response is { id, apiKey } — apiKey is the raw key, shown here ONCE.
# Only its SHA-256 hash is stored; losing this response means generating
# a new key, not recovering this one.
@apiKeyToken = PASTE_ACCESS_TOKEN_HERE
POST {{baseUrl}}/auth/api-keys
Content-Type: application/json
Authorization: Bearer {{apiKeyToken}}

{
  "label": "CI key"
}

### List my API keys (metadata only — id, label, createdAt, lastUsedAt;
# never the raw key or its hash). lastUsedAt starts null.
GET {{baseUrl}}/auth/api-keys
Authorization: Bearer {{apiKeyToken}}

### Identify myself using the API key alone — ApiKeyGuard only, no JWT
# involved at all. Response is deliberately the same shape as
# GET /auth/profile: same identity, a different mechanism proving it.
@rawApiKey = PASTE_RAW_API_KEY_HERE
GET {{baseUrl}}/auth/api-keys/whoami
x-api-key: {{rawApiKey}}

### Re-list my keys — lastUsedAt should now be set, proving the guard's
# lookup (and its lastUsedAt update) actually ran on the request above.
GET {{baseUrl}}/auth/api-keys
Authorization: Bearer {{apiKeyToken}}

### whoami with a garbage key (should 401)
GET {{baseUrl}}/auth/api-keys/whoami
x-api-key: not-a-real-key

### whoami with no x-api-key header at all (should 401)
GET {{baseUrl}}/auth/api-keys/whoami

### Revoke the key (paste the id from the "mint a key" response above)
DELETE {{baseUrl}}/auth/api-keys/PASTE_KEY_ID_HERE
Authorization: Bearer {{apiKeyToken}}

### whoami again with the same now-revoked key (should 401) — proves
# revocation actually removes access, not just the list entry.
GET {{baseUrl}}/auth/api-keys/whoami
x-api-key: {{rawApiKey}}

### Revoke a key that isn't mine, or doesn't exist (should 404 either
# way — a revoke attempt can't be used to probe which ids exist)
DELETE {{baseUrl}}/auth/api-keys/999999
Authorization: Bearer {{apiKeyToken}}
