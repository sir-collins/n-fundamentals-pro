@baseUrl = http://localhost:3000

### Get all songs (paginated — defaults to page 1, limit 10)
# Response shape: { "data": Song[], "total": number }
GET {{baseUrl}}/songs

### Get songs, page 2 with 5 per page
GET {{baseUrl}}/songs?page=2&limit=5

### Create new song
POST {{baseUrl}}/songs
Content-Type: application/json

{
  "title": "Blinding Lights",
  "artists": ["The Weeknd"],
  "releaseDate": "2019-11-29",
  "duration": "00:03"
}

### Get a single song
# artists comes back as [{ id, name }, ...] — real Artist rows, not strings.
# Reusing "The Weeknd" across songs resolves to the same Artist id.
GET {{baseUrl}}/songs/1

### Update a song
# artists here is still names in, same as create — replaces this song's
# artists entirely (not additive). A name already used elsewhere is reused,
# not duplicated; a name dropped from every song stays as an orphaned
# Artist row (nothing prunes those yet).
PUT {{baseUrl}}/songs/1
Content-Type: application/json

{
  "title": "Blinding Lights (Remix)",
  "artists": ["The Weeknd", "Rosalía"],
  "releaseDate": "2020-08-05",
  "duration": "00:03"
}

### Delete a song
DELETE {{baseUrl}}/songs/1

### Sign up
# Response is { id, email } only — the password hash never comes back.
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### Sign up again with the same email (should 409)
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### Log in
# Response is { access_token }. AuthGuard('local') checks email/password
# against the stored bcrypt hash before this ever reaches the handler.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "correcthorsebattery"
}

### Log in with the wrong password (should 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "wrongpassword"
}

### Log in with an email that was never signed up (should 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "correcthorsebattery"
}

### Get my profile (paste in a fresh access_token from "Log in" above)
# First protected route — AuthGuard('jwt') checks the token before this
# ever runs. Response is { id, email }.
@token = PASTE_ACCESS_TOKEN_HERE
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{token}}

### Get my profile with no token (should 401)
GET {{baseUrl}}/auth/profile
